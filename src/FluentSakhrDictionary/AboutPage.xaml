<Page
    x:Class="FluentSakhrDictionary.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="6" MaxWidth="560">
            <TextBlock Text="About" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <Border CornerRadius="12" Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <Image Source="/app.ico" Width="96" Height="96"/>
                    <TextBlock Text="Fluent Sakhr Dictionary" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="قاموس صخر" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="VersionText" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="A modern rebirth of the classic 1996 Sakhr English-Arabic dictionary: 59,427 lemmas, 125,896 Arabic meanings with full diacritics, fully offline."
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Padding="24" Margin="0,12,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="brought to you by app.instinct AI" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Developer: Mohamed Elnaggar" FontSize="13"/>
                    <TextBlock Text="Contributors: app.instinct" FontSize="13"/>
                    <TextBlock Text="License: MIT" FontSize="13"/>
                    <TextBlock Text="English-Arabic data: the original 1996 Sakhr dictionary" FontSize="13"/>
                    <TextBlock Text="Arabic-English data: English Wiktionary via kaikki.org (wiktextract), CC BY-SA 4.0" FontSize="13" TextWrapping="Wrap"/>
                    <HyperlinkButton Content="github.com/MohamedElnaggar00/Fluent-Sakhr-Dictionary"
                                     NavigateUri="https://github.com/MohamedElnaggar00/Fluent-Sakhr-Dictionary"
                                     FontSize="13" Padding="0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
