<Page
    x:Class="FluentSakhrDictionary.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="6" MaxWidth="560">
            <TextBlock x:Name="HeaderText" Text="About" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <Border CornerRadius="12" Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <Image Source="/app-icon-256.png" Width="96" Height="96"/>
                    <TextBlock Text="Sakhr Dictionary Revive" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="قاموس صخر" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="VersionText" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DescText" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="OfflineText" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Padding="24" Margin="0,12,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <HyperlinkButton Content="brought to you by Instinct"
                                     NavigateUri="https://instinct.com"
                                     FontSize="14" FontWeight="SemiBold" Padding="0"/>
                    <TextBlock x:Name="DevText" FontSize="13"/>
                    <TextBlock x:Name="ContribText" FontSize="13"/>
                    <TextBlock x:Name="LicenseText" FontSize="13"/>
                    <TextBlock x:Name="DataEnText" FontSize="13" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DataArText" FontSize="13" TextWrapping="Wrap"/>
                    <HyperlinkButton Content="github.com/MohamedElnaggar00/Sakhr-Dictionary-Revive"
                                     NavigateUri="https://github.com/MohamedElnaggar00/Sakhr-Dictionary-Revive"
                                     FontSize="13" Padding="0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
