<Application
    x:Class="FluentSakhrDictionary.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#00A6A6</Color>
            <Color x:Key="SystemAccentColorDark1">#008C8C</Color>
            <Color x:Key="SystemAccentColorDark2">#007373</Color>
            <Color x:Key="SystemAccentColorDark3">#005A5A</Color>
            <Color x:Key="SystemAccentColorLight1">#1AAFAF</Color>
            <Color x:Key="SystemAccentColorLight2">#33B8B8</Color>
            <Color x:Key="SystemAccentColorLight3">#4DC2C2</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
