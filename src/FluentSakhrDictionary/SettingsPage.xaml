<Page
    x:Class="FluentSakhrDictionary.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="8" MaxWidth="560">
            <TextBlock x:Name="HeaderText" Text="Settings" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <TextBlock x:Name="LanguageHeader" Text="Language" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <RadioButtons x:Name="LanguagePicker" SelectedIndex="0" SelectionChanged="Language_Changed">
                <RadioButton x:Name="LangSystem" Content="Match device (default)" Tag="system"/>
                <RadioButton Content="English" Tag="en"/>
                <RadioButton Content="العربية" Tag="ar"/>
            </RadioButtons>

            <TextBlock x:Name="ThemeHeader" Text="Theme" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <RadioButtons x:Name="ThemePicker" SelectedIndex="0" SelectionChanged="Setting_Changed">
                <RadioButton x:Name="ThemeSystem" Content="Use system setting" Tag="Default"/>
                <RadioButton x:Name="ThemeLight" Content="Light" Tag="Light"/>
                <RadioButton x:Name="ThemeDark" Content="Dark" Tag="Dark"/>
            </RadioButtons>

            <TextBlock x:Name="AccentHeader" Text="Accent color" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <StackPanel x:Name="AccentRow1" Orientation="Horizontal" Spacing="8"/>
                <StackPanel x:Name="AccentRow2" Orientation="Horizontal" Spacing="8"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button x:Name="AccentCustomButton" Content="Custom color..." Click="AccentCustom_Click"/>
                <Button x:Name="AccentResetButton" Content="Reset to default" Click="AccentReset_Click"/>
            </StackPanel>

            <TextBlock x:Name="DictionaryHeader" Text="Dictionary" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <ToggleSwitch x:Name="WiktionaryToggle" Header="Wiktionary database" OnContent="On" OffContent="Off" Toggled="Wiktionary_Toggled"/>
            <TextBlock x:Name="WiktionaryNote" TextWrapping="Wrap" FontSize="12" FlowDirection="RightToLeft" Margin="0,4,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="BackdropHeader" Text="Backdrop" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <RadioButtons x:Name="BackdropPicker" SelectedIndex="0" SelectionChanged="Setting_Changed">
                <RadioButton x:Name="BackdropMica" Content="Mica" Tag="Mica"/>
                <RadioButton x:Name="BackdropMicaAlt" Content="Mica Alt" Tag="MicaAlt"/>
                <RadioButton x:Name="BackdropAcrylic" Content="Desktop Acrylic" Tag="Acrylic"/>
            </RadioButtons>

            <TextBlock x:Name="UpdatesHeader" Text="Updates" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <TextBlock x:Name="UpdatesNote" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            <Button x:Name="CheckButton" Content="Check for updates" Click="CheckUpdates_Click" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="UpdateResult" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <HyperlinkButton x:Name="UpdateLink" Content="Open download page" Visibility="Collapsed" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
