<Window
    x:Class="FluentSakhrDictionary.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- XAML caption controls follow RTL without reflecting the render surface. -->
        <Grid Canvas.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="AppTitleBar" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="app.ico" Width="20" Height="20" Margin="12,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Sakhr Dictionary Revive - قاموس صخر الحديث" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Width="46" Height="48" CornerRadius="0" Background="Transparent" BorderThickness="0" Click="Minimize_Click" AutomationProperties.Name="Minimize">
                    <FontIcon Glyph="&#xE921;" FontSize="10"/>
                </Button>
                <Button x:Name="MaximizeButton" Width="46" Height="48" CornerRadius="0" Background="Transparent" BorderThickness="0" Click="Maximize_Click" AutomationProperties.Name="Maximize or restore">
                    <FontIcon x:Name="MaximizeGlyph" Glyph="&#xE922;" FontSize="10"/>
                </Button>
                <Button x:Name="CloseButton" Width="46" Height="48" CornerRadius="0" Background="Transparent" BorderThickness="0" Click="Close_Click" AutomationProperties.Name="Close">
                    <FontIcon Glyph="&#xE8BB;" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="LeftCompact"
                        IsPaneOpen="False"
                        IsPaneToggleButtonVisible="True"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="200"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavSearch" Content="Search" Tag="search" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavSettings" Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAbout" Content="About" Tag="about">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <!-- Floating content card: Mica shows through at the right/bottom margins -->
            <Border Margin="0,0,16,16"
                    CornerRadius="8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Frame x:Name="ContentFrame"/>
            </Border>
        </NavigationView>
    </Grid>
</Window>
