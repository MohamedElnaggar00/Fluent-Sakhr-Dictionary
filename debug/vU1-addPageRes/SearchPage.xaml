<Page
    x:Class="FluentSakhrDictionary.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <SolidColorBrush x:Key="MeaningBrush" Color="#D64532"/>
    </Page.Resources>
    <Grid Padding="24,12,24,24">
        <Border x:Name="MeaningCard"
                CornerRadius="12"
                Padding="28"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="WordTitle" FontSize="34" FontWeight="SemiBold" Text="قاموس صخر"/>
                    <TextBlock x:Name="WordSubtitle" FontSize="13" Margin="0,2,0,18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Fluent Sakhr Dictionary"/>
                    <ItemsRepeater x:Name="MeaningsRepeater">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid FlowDirection="RightToLeft" Margin="0,8">
                                    <TextBlock Foreground="{StaticResource MeaningBrush}" Text="{Binding}"
                                               FontSize="22"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical"/>
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <TextBlock x:Name="NotFoundText" Visibility="Collapsed" Margin="0,8,0,0" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
