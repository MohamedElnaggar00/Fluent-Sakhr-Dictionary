<Page
    x:Class="FluentSakhrDictionary.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24,12,24,24" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Left: search + live word list -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Type an English word..." FontSize="16" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
            <ListView x:Name="ResultsList" Grid.Row="1" SelectionMode="Single" SelectionChanged="ResultsList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Word}" FontSize="15" Padding="4,6"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <!-- Right: meaning pane -->
        <Border Grid.Column="1" x:Name="MeaningCard"
                CornerRadius="12"
                Padding="28"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="WordTitle" FontSize="34" FontWeight="SemiBold" Text="قاموس صخر"/>
                    <TextBlock x:Name="WordSubtitle" FontSize="13" Margin="0,2,0,18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Fluent Sakhr Dictionary"/>
                    <ItemsRepeater x:Name="MeaningsRepeater">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid FlowDirection="RightToLeft" Margin="0,8">
                                    <TextBlock Text="{Binding}"
                                               FontSize="22"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical"/>
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <TextBlock x:Name="NotFoundText" Visibility="Collapsed" Margin="0,8,0,0" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
