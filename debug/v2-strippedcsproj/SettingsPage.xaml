<Page
    x:Class="FluentSakhrDictionary.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="8" MaxWidth="560">
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <TextBlock Text="Theme" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <RadioButtons x:Name="ThemePicker" SelectedIndex="0" SelectionChanged="Setting_Changed">
                <RadioButton Content="Use system setting" Tag="Default"/>
                <RadioButton Content="Light" Tag="Light"/>
                <RadioButton Content="Dark" Tag="Dark"/>
            </RadioButtons>

            <TextBlock Text="Backdrop" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <RadioButtons x:Name="BackdropPicker" SelectedIndex="0" SelectionChanged="Setting_Changed">
                <RadioButton Content="Mica" Tag="Mica"/>
                <RadioButton Content="Mica Alt" Tag="MicaAlt"/>
                <RadioButton Content="Desktop Acrylic" Tag="Acrylic"/>
            </RadioButtons>
        </StackPanel>
    </ScrollViewer>
</Page>
