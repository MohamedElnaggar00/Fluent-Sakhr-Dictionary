<Page
    x:Class="FluentSakhrDictionary.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <SolidColorBrush x:Key="MeaningBrush" Color="#D64532"/>
    </Page.Resources>

    <Grid Padding="24,12,24,24" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: search + live word list -->
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="SearchBox"
                     PlaceholderText="Type an English word..."
                     FontSize="16"
                     TextChanged="SearchBox_TextChanged"
                     KeyDown="SearchBox_KeyDown">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#C4381C"/>
                </TextBox.Resources>
            </TextBox>
            <ListView x:Name="ResultsList" Grid.Row="1"
                      SelectionMode="Single"
                      SelectionChanged="ResultsList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Word}" FontSize="15" Padding="4,6"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Right: meaning pane -->
        <Grid Grid.Column="1">
            <Border x:Name="MeaningCard"
                    CornerRadius="12"
                    Padding="28"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="WordTitle" FontSize="34" FontWeight="SemiBold" Text="قاموس صخر"/>
                        <TextBlock x:Name="WordSubtitle" FontSize="13" Margin="0,2,0,18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Fluent Sakhr Dictionary - 59,427 lemmas from the original 1996 Sakhr English-Arabic dictionary"/>
                            <TextBlock x:Name="NotFoundText" Visibility="Collapsed" Margin="0,8,0,0" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
