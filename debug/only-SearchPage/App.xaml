<Application
    x:Class="FluentSakhrDictionary.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#C4381C</Color>
            <Color x:Key="SystemAccentColorDark1">#A32F18</Color>
            <Color x:Key="SystemAccentColorDark2">#822613</Color>
            <Color x:Key="SystemAccentColorDark3">#611C0E</Color>
            <Color x:Key="SystemAccentColorLight1">#D4553B</Color>
            <Color x:Key="SystemAccentColorLight2">#E07A64</Color>
            <Color x:Key="SystemAccentColorLight3">#EB9E8D</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
