<Page
    x:Class="FluentSakhrDictionary.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="MeaningBrush" Color="#B22E1A"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="MeaningBrush" Color="#FF8A75"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Padding="24,12,24,24" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="SearchBox"
                     PlaceholderText="Type an English word..."
                     FontSize="16"
                     TextChanged="SearchBox_TextChanged"
                     KeyDown="SearchBox_KeyDown">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#C4381C"/>
                </TextBox.Resources>
            </TextBox>
            <ListView x:Name="ResultsList" Grid.Row="1"
                      SelectionMode="Single"
                      SelectionChanged="ResultsList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Word}" FontSize="15" Padding="4,6"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
